#!/bin/bash

# ============================================================
# massmap - Robust Masscan + Multi-Nmap comparator for HTB/VPN
# ============================================================

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

# Defaults
USE_MASSCAN=true
DO_SERVICE=true
NMAP_COUNT=2
RATE=2000                    # Slightly conservative for VPN stability
FORCE_IFACE=""
OUTPUT=""
TARGET=""

#######################################
# Help
#######################################
usage() {
    echo -e "${BOLD}Usage:${NC}"
    echo -e "  $0 [options] <output_name> <target_ip>"
    echo
    echo -e "${BOLD}Options:${NC}"
    echo -e "  -n, --nmap-only          Skip Masscan completely"
    echo -e "  -s, --no-service         Skip service/version/scripts (-sV -sC)"
    echo -e "  -c, --count N            Number of Nmap scans (1-10, default: 2)"
    echo -e "  -r, --rate N             Packets/sec for Masscan & Nmap (default: 2000)"
    echo -e "  -i, --interface IFACE    Force interface (default: auto-detect best)"
    echo -e "  -h, --help               Show this help"
    echo
    echo -e "${BOLD}Examples:${NC}"
    echo -e "  $0 swagshop 10.129.229.138"
    echo -e "  $0 -c 3 -s swagshop 10.129.229.138          # 3 pure port scans, no service"
    echo -e "  $0 -n -c 4 --no-service target 10.10.11.50  # 4 nmap only, fast"
    echo -e "  $0 -r 1000 -i tun0 box 10.129.1.50"
    exit 1
}

#######################################
# Argument parsing
#######################################
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--nmap-only)
            USE_MASSCAN=false
            shift
            ;;
        -s|--no-service)
            DO_SERVICE=false
            shift
            ;;
        -c|--count)
            NMAP_COUNT="$2"
            if ! [[ "$NMAP_COUNT" =~ ^[0-9]+$ ]] || [ "$NMAP_COUNT" -lt 1 ] || [ "$NMAP_COUNT" -gt 10 ]; then
                echo -e "${RED}[!] --count must be between 1 and 10${NC}"
                exit 1
            fi
            shift 2
            ;;
        -r|--rate)
            RATE="$2"
            shift 2
            ;;
        -i|--interface)
            FORCE_IFACE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo -e "${RED}[!] Unknown option: $1${NC}"
            usage
            ;;
        *)
            if [ -z "$OUTPUT" ]; then
                OUTPUT="$1"
            elif [ -z "$TARGET" ]; then
                TARGET="$1"
            else
                echo -e "${RED}[!] Too many arguments${NC}"
                usage
            fi
            shift
            ;;
    esac
done

if [ -z "$OUTPUT" ] || [ -z "$TARGET" ]; then
    usage
fi

SUMMARY_FILE="${OUTPUT}_summary.txt"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

#######################################
# Best Interface Selection
#######################################
get_best_interface() {
    local target=$1

    if [ -n "$FORCE_IFACE" ]; then
        echo "$FORCE_IFACE"
        return
    fi

    # 1. Kernel routing decision (most accurate)
    local iface
    iface=$(ip -o route get "$target" 2>/dev/null | \
            awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')

    if [ -n "$iface" ] && ip link show "$iface" &>/dev/null; then
        if ip link show "$iface" | grep -qE "state UP|UP,"; then
            echo "$iface"
            return
        fi
    fi

    # 2. Prefer tun0
    if ip link show tun0 &>/dev/null && ip link show tun0 | grep -qE "state UP|UP,"; then
        echo "tun0"
        return
    fi

    # 3. Any other active tun*
    for t in /sys/class/net/tun*; do
        [ -d "$t" ] || continue
        local name=$(basename "$t")
        if ip link show "$name" 2>/dev/null | grep -qE "state UP|UP,"; then
            echo "$name"
            return
        fi
    done

    echo "tun0"
}

INTERFACE=$(get_best_interface "$TARGET")

#######################################
# Banner
#######################################
echo -e "${BLUE}==============================================${NC}"
echo -e "${GREEN}[*] Target        : ${TARGET}${NC}"
echo -e "${GREEN}[*] Output Name   : ${OUTPUT}${NC}"
echo -e "${GREEN}[*] Interface     : ${INTERFACE}${NC}"
echo -e "${GREEN}[*] Rate          : ${RATE}${NC}"
echo -e "${GREEN}[*] Nmap scans    : ${NMAP_COUNT}${NC}"
if [ "$USE_MASSCAN" = true ]; then
    echo -e "${GREEN}[*] Mode          : Masscan + ${NMAP_COUNT}× Nmap${NC}"
else
    echo -e "${GREEN}[*] Mode          : Nmap only (${NMAP_COUNT} scans)${NC}"
fi
if [ "$DO_SERVICE" = true ]; then
    echo -e "${GREEN}[*] Service scan  : Enabled (-sV -sC)${NC}"
else
    echo -e "${YELLOW}[*] Service scan  : Disabled (port discovery only)${NC}"
fi
echo -e "${BLUE}==============================================${NC}"

#######################################
# 1. Masscan (optional)
#######################################
MASSCAN_PORTS=""
if [ "$USE_MASSCAN" = true ]; then
    echo -e "\n${YELLOW}[+] Running Masscan on ${INTERFACE} (rate=${RATE})...${NC}"

    # Show the exact command for debugging
    echo -e "${CYAN}    → sudo masscan -p1-65535 $TARGET --rate=$RATE -e $INTERFACE --wait 2 --open-only -oL ${OUTPUT}_masscan.txt${NC}"

    # Run with slightly longer timeout + wait
    timeout 70s sudo masscan -p1-65535 "$TARGET" \
        --rate="$RATE" \
        -e "$INTERFACE" \
        --wait 2 \
        --open-only \
        -oL "${OUTPUT}_masscan.txt" 2>"${OUTPUT}_masscan.err"

    MASSCAN_EXIT=$?

    if [ -f "${OUTPUT}_masscan.txt" ] && grep -q "open" "${OUTPUT}_masscan.txt" 2>/dev/null; then
        MASSCAN_PORTS=$(grep "open" "${OUTPUT}_masscan.txt" | awk '{print $3}' | sort -n | uniq | tr '\n' ' ')
        echo -e "${GREEN}[+] Masscan found ports: ${MASSCAN_PORTS}${NC}"
    else
        echo -e "${YELLOW}[!] Masscan found no open ports or failed.${NC}"
        if [ -s "${OUTPUT}_masscan.err" ]; then
            echo -e "${RED}    Masscan error output:${NC}"
            sed 's/^/    /' "${OUTPUT}_masscan.err"
        fi
        if [ $MASSCAN_EXIT -eq 124 ]; then
            echo -e "${RED}    → Timed out. Try lowering rate with -r 1000${NC}"
        fi
        echo -e "${YELLOW}    Tip: On HTB VPN, rates >1500-2000 often miss ports. Try -r 1000${NC}"
        MASSCAN_PORTS=""
    fi
    rm -f "${OUTPUT}_masscan.err"
else
    echo -e "\n${YELLOW}[!] Skipping Masscan (nmap-only mode)${NC}"
fi

#######################################
# 2. Multiple Nmap scans
#######################################
declare -a NMAP_FILES=()
declare -a ALL_NMAP_PORTS=()

NMAP_BASE_OPTS="-Pn -p- -v --min-rate=$RATE --open"
if [ "$DO_SERVICE" = true ]; then
    NMAP_BASE_OPTS="$NMAP_BASE_OPTS -sV -sC"
fi

for ((i=1; i<=NMAP_COUNT; i++)); do
    NMAP_FILE="${OUTPUT}_${i}.nmap"
    NMAP_FILES+=("$NMAP_FILE")

    echo -e "\n${YELLOW}[+] Running Nmap Scan #${i}/${NMAP_COUNT}...${NC}"
    echo -e "${CYAN}    → sudo nmap $NMAP_BASE_OPTS -oN $NMAP_FILE $TARGET${NC}"

    sudo nmap $NMAP_BASE_OPTS -oN "$NMAP_FILE" "$TARGET"

    # Extract open ports from this scan
    ports=$(grep -E "^[0-9]+/tcp\s+open" "$NMAP_FILE" 2>/dev/null | cut -d'/' -f1 | sort -n | uniq)
    ALL_NMAP_PORTS+=("$ports")
done

#######################################
# Extract & normalize ports
#######################################
masscan_ports=$(echo "$MASSCAN_PORTS" | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -n | uniq)

# Build sorted unique lists
echo "$masscan_ports" > /tmp/mm_masscan_$$.tmp

# Collect every nmap open port set
> /tmp/mm_all_nmap_$$.tmp
for ((i=0; i<NMAP_COUNT; i++)); do
    echo "${ALL_NMAP_PORTS[$i]}" | tr ' ' '\n' | grep -E '^[0-9]+$' >> /tmp/mm_all_nmap_$$.tmp
    echo "${ALL_NMAP_PORTS[$i]}" | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -n | uniq > /tmp/mm_nmap${i}_$$.tmp
done
sort -n /tmp/mm_all_nmap_$$.tmp | uniq > /tmp/mm_all_nmap_sorted_$$.tmp

# Union of everything
cat /tmp/mm_masscan_$$.tmp /tmp/mm_all_nmap_sorted_$$.tmp | sort -n | uniq > /tmp/mm_union_$$.tmp
all_scanners=$(cat /tmp/mm_union_$$.tmp)

# Confirmed = appeared as open in ≥ 2 scanners (masscan counts as 1)
confirmed=$(cat /tmp/mm_masscan_$$.tmp /tmp/mm_all_nmap_$$.tmp | grep -E '^[0-9]+$' | sort -n | uniq -c | awk '$1 >= 2 {print $2}')

#######################################
# Advanced difference detection
#######################################
# Ports only in masscan
only_masscan=$(comm -23 /tmp/mm_masscan_$$.tmp /tmp/mm_all_nmap_sorted_$$.tmp)

# Ports that first appeared in a later nmap scan (were missing or filtered earlier)
newly_open=""
if [ "$NMAP_COUNT" -ge 2 ]; then
    # Ports in the last scan that were NOT in any previous nmap scan
    last_idx=$((NMAP_COUNT-1))
    earlier=$(cat /tmp/mm_nmap{0..$((last_idx-1))}_$$.tmp 2>/dev/null | sort -n | uniq)
    echo "$earlier" > /tmp/mm_earlier_$$.tmp
    newly_open=$(comm -13 /tmp/mm_earlier_$$.tmp /tmp/mm_nmap${last_idx}_$$.tmp)
fi

# Ports that were open in early scans but missing in the final one (possible flapping)
flapping=""
if [ "$NMAP_COUNT" -ge 2 ]; then
    first_ports=$(cat /tmp/mm_nmap0_$$.tmp)
    last_ports=$(cat /tmp/mm_nmap$((NMAP_COUNT-1))_$$.tmp)
    echo "$first_ports" > /tmp/mm_first_$$.tmp
    echo "$last_ports"  > /tmp/mm_last_$$.tmp
    flapping=$(comm -23 /tmp/mm_first_$$.tmp /tmp/mm_last_$$.tmp)
fi

#######################################
# Helper: get best service line (prefer latest scan)
#######################################
get_service() {
    local port=$1
    local info=""
    # Search from newest to oldest
    for ((i=NMAP_COUNT; i>=1; i--)); do
        info=$(grep -E "^${port}/tcp\s+open" "${OUTPUT}_${i}.nmap" 2>/dev/null)
        if [ -n "$info" ]; then
            echo "$info" | sed 's/\s\+/ /g'
            return
        fi
    done
    echo "${port}/tcp open  (no service info)"
}

#######################################
# Write Summary File
#######################################
{
echo "=============================================="
echo " MASSMAP - PORT SCAN COMPARISON SUMMARY"
echo "=============================================="
echo "Target        : $TARGET"
echo "Output Name   : $OUTPUT"
echo "Date          : $DATE"
echo "Interface     : $INTERFACE"
echo "Rate          : $RATE"
echo "Nmap scans    : $NMAP_COUNT"
echo "Mode          : $([ "$USE_MASSCAN" = true ] && echo "Masscan + ${NMAP_COUNT}× Nmap" || echo "Nmap only (${NMAP_COUNT} scans)")"
echo "Service scan  : $([ "$DO_SERVICE" = true ] && echo "Yes (-sV -sC)" || echo "No (port discovery only)")"
echo "=============================================="
echo ""
echo "[*] Masscan Ports:"
echo "${masscan_ports:-None}"
echo ""

for ((i=1; i<=NMAP_COUNT; i++)); do
    ports=$(grep -E "^[0-9]+/tcp\s+open" "${OUTPUT}_${i}.nmap" 2>/dev/null | cut -d'/' -f1 | sort -n | uniq | tr '\n' ' ')
    echo "[*] Nmap #${i} Ports:"
    echo "${ports:-None}"
    echo ""
done

echo "----------- CHANGES / DIFFERENCES -----------"
echo ""
echo "[+] Newly appeared as OPEN in the final Nmap scan:"
echo "${newly_open:-None}"
echo ""
echo "[+] Only found by Masscan:"
echo "${only_masscan:-None}"
echo ""
echo "[+] Flapping / disappeared in final scan:"
echo "${flapping:-None}"
echo ""
echo "=============================================="
echo " FINAL CONFIRMED OPEN PORTS (≥ 2 scanners)"
echo "=============================================="
if [ -n "$confirmed" ]; then
    while read -r port; do
        [ -z "$port" ] && continue
        echo "  → $(get_service $port)"
    done <<< "$confirmed"
else
    echo "  None (falling back to union of all findings)"
fi
echo ""
echo "=============================================="
echo " RECOMMENDED PORTS FOR FURTHER ENUMERATION"
echo "=============================================="
if [ -n "$confirmed" ]; then
    echo "$confirmed" | tr '\n' ',' | sed 's/,$//'
    echo ""
else
    echo "$all_scanners" | tr '\n' ',' | sed 's/,$//'
    echo ""
fi
echo ""
echo "=============================================="
echo " FILES GENERATED"
echo "=============================================="
[ "$USE_MASSCAN" = true ] && echo "  • ${OUTPUT}_masscan.txt"
for ((i=1; i<=NMAP_COUNT; i++)); do
    echo "  • ${OUTPUT}_${i}.nmap"
done
echo "  • ${OUTPUT}_summary.txt  ← this file"
echo "=============================================="
} | tee "$SUMMARY_FILE"

#######################################
# Colored terminal summary
#######################################
echo -e "\n${BLUE}==============================================${NC}"
echo -e "${CYAN}           SCAN COMPARISON SUMMARY${NC}"
echo -e "${BLUE}==============================================${NC}"

echo -e "\n${YELLOW}[*] Interface used :${NC} ${INTERFACE}"
echo -e "${YELLOW}[*] Masscan Ports  :${NC} ${masscan_ports:-None}"

for ((i=1; i<=NMAP_COUNT; i++)); do
    ports=$(grep -E "^[0-9]+/tcp\s+open" "${OUTPUT}_${i}.nmap" 2>/dev/null | cut -d'/' -f1 | sort -n | uniq | tr '\n' ' ')
    echo -e "${YELLOW}[*] Nmap #${i} Ports   :${NC} ${ports:-None}"
done

echo -e "\n${CYAN}----------- Changes Detected -----------${NC}"

echo -e "\n${GREEN}[+] Newly open in final Nmap scan (was filtered/closed/missing earlier):${NC}"
if [ -n "$newly_open" ]; then
    while read -r p; do
        [ -z "$p" ] && continue
        echo -e "  ${GREEN}→${NC} $(get_service $p)"
    done <<< "$newly_open"
else
    echo "  None"
fi

echo -e "\n${YELLOW}[+] Only found by Masscan:${NC}"
echo "  ${only_masscan:-None}"

echo -e "\n${YELLOW}[+] Flapping / gone in final scan:${NC}"
echo "  ${flapping:-None}"

echo -e "\n${GREEN}[+] Final Confirmed Open Ports (≥2 scanners):${NC}"
if [ -n "$confirmed" ]; then
    while read -r port; do
        [ -z "$port" ] && continue
        echo -e "  ${GREEN}→${NC} $(get_service $port)"
    done <<< "$confirmed"
else
    echo -e "  ${YELLOW}None confirmed → showing full union${NC}"
    while read -r port; do
        [ -z "$port" ] && continue
        echo -e "  ${CYAN}→${NC} $(get_service $port)"
    done <<< "$all_scanners"
fi

echo -e "\n${PURPLE}[+] Recommended ports string:${NC}"
if [ -n "$confirmed" ]; then
    echo -e "  ${CYAN}$(echo "$confirmed" | tr '\n' ',' | sed 's/,$//')${NC}"
else
    echo -e "  ${CYAN}$(echo "$all_scanners" | tr '\n' ',' | sed 's/,$//')${NC}"
fi

echo -e "\n${BLUE}==============================================${NC}"
echo -e "${GREEN}[+] Scan finished${NC}"
[ "$USE_MASSCAN" = true ] && echo -e "  • ${OUTPUT}_masscan.txt"
for ((i=1; i<=NMAP_COUNT; i++)); do
    echo -e "  • ${OUTPUT}_${i}.nmap"
done
echo -e "  • ${GREEN}${OUTPUT}_summary.txt${NC}  ← full comparison"
echo -e "${BLUE}==============================================${NC}"

# Cleanup
rm -f /tmp/mm_*_$$.tmp
