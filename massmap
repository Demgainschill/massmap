#!/bin/bash

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

if [ $# -lt 2 ]; then
    echo -e "${RED}Usage:${NC} $0 <output_name> <target_ip>"
    echo -e "Example: $0 blocky_results 10.129.238.31"
    exit 1
fi

OUTPUT=$1
TARGET=$2
RATE=3000   # Slightly lower rate for better reliability

echo -e "${BLUE}==============================================${NC}"
echo -e "${GREEN}[*] Target      : ${TARGET}${NC}"
echo -e "${GREEN}[*] Output Name : ${OUTPUT}${NC}"
echo -e "${GREEN}[*] Min Rate    : ${RATE}${NC}"
echo -e "${BLUE}==============================================${NC}"

#######################################
# 1. Masscan
#######################################
echo -e "\n${YELLOW}[+] Running Masscan on tun0...${NC}"
timeout 120s sudo masscan -p1-65535 $TARGET --rate=$RATE -e tun0 --wait 0 -oL ${OUTPUT}_masscan.txt

echo -e "${GREEN}[+] Masscan completed${NC}"

echo -e "\n${GREEN}[+] Open ports found by Masscan:${NC}"
if grep -q "open" ${OUTPUT}_masscan.txt 2>/dev/null; then
    grep "open" ${OUTPUT}_masscan.txt | awk '{print $3}' | sort -n | tr '\n' ' '
    echo
else
    echo "None"
fi

#######################################
# 2. Nmap Scan #1
#######################################
echo -e "\n${YELLOW}[+] Running Nmap Scan #1...${NC}"
sudo nmap -Pn -sV -sC -p- -v --min-rate=$RATE -oN ${OUTPUT}_1.nmap $TARGET

#######################################
# 3. Nmap Scan #2
#######################################
echo -e "\n${YELLOW}[+] Running Nmap Scan #2...${NC}"
sudo nmap -Pn -sV -sC -p- -v --min-rate=$RATE -oN ${OUTPUT}_2.nmap $TARGET

#######################################
# SUMMARY
#######################################
echo -e "\n${BLUE}==============================================${NC}"
echo -e "${CYAN}           SCAN COMPARISON SUMMARY${NC}"
echo -e "${BLUE}==============================================${NC}"

# Extract ports
masscan_ports=$(grep "open" ${OUTPUT}_masscan.txt 2>/dev/null | awk '{print $3}' | sort -n | uniq)
nmap1_ports=$(grep -E "^[0-9]+/tcp\s+open" ${OUTPUT}_1.nmap 2>/dev/null | cut -d'/' -f1 | sort -n | uniq)
nmap2_ports=$(grep -E "^[0-9]+/tcp\s+open" ${OUTPUT}_2.nmap 2>/dev/null | cut -d'/' -f1 | sort -n | uniq)

echo -e "\n${YELLOW}[*] Masscan Ports:${NC}   ${masscan_ports:-None}"
echo -e "${YELLOW}[*] Nmap #1 Ports:${NC}   ${nmap1_ports:-None}"
echo -e "${YELLOW}[*] Nmap #2 Ports:${NC}   ${nmap2_ports:-None}"

echo -e "\n${CYAN}----------- Changes Detected -----------${NC}"

# New ports in Scan #2
new_in_scan2=$(comm -13 <(echo -e "$masscan_ports\n$nmap1_ports" | sort -n | uniq) <(echo "$nmap2_ports"))
echo -e "\n${GREEN}[+] New ports appeared in Nmap #2:${NC}"
echo "${new_in_scan2:-None}"

# Ports only found by Masscan
only_masscan=$(comm -23 <(echo "$masscan_ports") <(echo -e "$nmap1_ports\n$nmap2_ports" | sort -n | uniq))
echo -e "\n${YELLOW}[+] Only found by Masscan:${NC}"
echo "${only_masscan:-None}"

# Ports only found in Nmap #1
only_nmap1=$(comm -23 <(echo "$nmap1_ports") <(echo -e "$masscan_ports\n$nmap2_ports" | sort -n | uniq))
echo -e "\n${YELLOW}[+] Only found in Nmap #1:${NC}"
echo "${only_nmap1:-None}"

# Final confirmed ports (appeared in at least 2 tools/scans)
echo -e "\n${GREEN}[+] Final Confirmed Open Ports:${NC}"
confirmed=$(echo -e "$masscan_ports\n$nmap1_ports\n$nmap2_ports" | sort -n | uniq -c | awk '$1 >= 2 {print $2}')
echo "${confirmed:-None}"

echo -e "\n${BLUE}==============================================${NC}"
echo -e "${GREEN}[+] Scan finished${NC}"
echo -e "    • ${OUTPUT}_masscan.txt"
echo -e "    • ${OUTPUT}_1.nmap"
echo -e "    • ${OUTPUT}_2.nmap"
echo -e "${BLUE}==============================================${NC}"
